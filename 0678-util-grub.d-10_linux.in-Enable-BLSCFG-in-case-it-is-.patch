From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Leo Sandoval <lsandova@redhat.com>
Date: Tue, 22 Apr 2025 12:55:49 -0600
Subject: [PATCH] util/grub.d/10_linux.in: Enable BLSCFG in case it is not
 present

Resolves: #RHEL-86913

Signed-off-by: Leo Sandoval <lsandova@redhat.com>
---
 util/grub.d/10_linux.in | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/util/grub.d/10_linux.in b/util/grub.d/10_linux.in
index 48857bb81d..d3e716600f 100644
--- a/util/grub.d/10_linux.in
+++ b/util/grub.d/10_linux.in
@@ -136,6 +136,11 @@ linux_entry ()
       boot_device_id="$(grub_get_device_id "${GRUB_DEVICE}")"
   fi
 
+  # Make BLS the default if GRUB_ENABLE_BLSCFG was not set and grubby is not installed.
+  if [ -z "${GRUB_ENABLE_BLSCFG}" ] && ! command -v new-kernel-pkg >/dev/null; then
+      GRUB_ENABLE_BLSCFG="true"
+  fi
+
   if [ "x${GRUB_ENABLE_BLSCFG}" = "xtrue" ]; then
     if [ x$dirname = x/ ]; then
       if [ -z "${prepare_root_cache}" ]; then
